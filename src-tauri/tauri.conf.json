{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kormilant",
  "version": "0.1.0",
  "identifier": "dev.kormilant.app",
  "build": {
    "beforeDevCommand": "cargo build -q -p kormilant-core --bin kormilant-guard && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cargo build -q --release -p kormilant-core --bin kormilant-guard && npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Kormilant",
        "width": 1100,
        "height": 780
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}