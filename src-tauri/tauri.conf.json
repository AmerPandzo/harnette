{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harnette",
  "version": "0.1.0",
  "identifier": "dev.kormilant.app",
  "build": {
    "beforeDevCommand": "cargo build -q -p harnette-core --bin harnette-guard && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cargo build -q --release -p harnette-core --bin harnette-guard && npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Harnette",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "files": {
        "MacOS/harnette-guard": "../target/release/harnette-guard"
      },
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  }
}
